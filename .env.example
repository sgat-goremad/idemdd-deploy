# ============================================================
# .env.example — variables del stack de PRODUCCIÓN (Portainer)
#
# Copia estos nombres a las ENV VARS del stack en la UI de
# Portainer y pon los valores reales ahí. NO commitees valores.
# ============================================================

# --- Registry ---
REGISTRY=ghcr.io/sgat-goremad
API_TAG=latest
FRONTEND_TAG=latest

# --- Red / Traefik ---
# Red externa donde corre Traefik (la del stack anterior: "traefik").
# Se reutiliza el MISMO Traefik; no hace falta crear uno nuevo.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
# Certresolver del Traefik existente: se llama "ssl" (su proveedor ACME
# es Let's Encrypt). NO cambiar a menos que sepas el nombre exacto en
# la config estática de Traefik.
TRAEFIK_CERTRESOLVER=ssl

# --- Base de datos ---
# POSTGRES_HOST_PORT: puerto host para conexión remota a la BD.
# Durante la migración (mientras el stack viejo siga usando 9006)
# usa 9007; al eliminar el viejo, vuelve a 9006.
POSTGRES_HOST_PORT=9006
POSTGRES_USER=idemdd
POSTGRES_PASSWORD=change_me
POSTGRES_DB=idemdd

# --- JWT ---
JWT_KEY=change_me_min_32_chars
JWT_ISSUER=idegoremad-prod
JWT_AUDIENCE=idemdd-client

# --- OCR ---
OCR_ENABLED=true
OCR_MAX_PAGES=10
OCR_MAX_CHARS=50000
OCR_TIMEOUT=00:02:00

# --- GeoServer (publicación WMS/WFS de vistas SQL) ---
# Activar o desactivar el módulo completo de WfsPublication.
# Si es "false", los endpoints /api/cadastre-tables/wfs/* devuelven 503.
GEOSERVER_ENABLED=true

# URL base de GeoServer SIN trailing slash. En prod es el subdominio público.
GEOSERVER_BASE_URL=https://geoserver.cur.regionmadrededios.gob.pe/geoserver

# Credenciales admin de GeoServer. SECRETOS — nunca commitear valores reales.
GEOSERVER_USERNAME=admin
GEOSERVER_PASSWORD=change_me

# Prefijo para derivar el nombre del workspace GeoServer.
# El nombre final es {WorkspacePrefix}_{Organization.Prefix}_{public|private}.
GEOSERVER_WORKSPACE_PREFIX=idemdd

# Template del namespace URI del workspace.
# {0} = Organization.Prefix, {1} = "public" o "private".
# En prod usar el dominio público del IDE (HTTPS).
GEOSERVER_NAMESPACE_URI_TEMPLATE=https://ide.regionmadrededios.gob.pe/idemdd/{0}_{1}/geo

# Template del nombre del datastore PostGIS.
# Si contiene {0}, se usa como template y se reemplaza por el schema
# físico de la tabla (modo recomendado, un datastore por schema:
# idemdd_postgis_forestal_objetos, idemdd_postgis_forestal_dominios, etc.).
# Si NO contiene {0}, se usa como nombre fijo (modo legacy, un solo
# datastore por workspace sin schema: idemdd_postgis).
GEOSERVER_DATASTORE_NAME=idemdd_postgis_{0}

# Connection string de Postgres DEDICADA para el datastore de GeoServer.
# Si está vacía, el backend usa la connection string del backend
# (ConnectionStrings:PostgreSQLConnection). En prod se recomienda
# un usuario dedicado de solo lectura (ej: geoserver_ro) con
# search_path pre-configurado a los schemas donde están las vistas.
# Formato Npgsql: "Host=db;Port=5432;Database=idemdd;User Id=geoserver_ro;Password=xxx"
GEOSERVER_POSTGRES_CONNECTION_STRING=

# Timeout HTTP para las llamadas a GeoServer (segundos).
GEOSERVER_REQUEST_TIMEOUT_SECONDS=30

# --- Storage (archivos digitalizados) ---
# "local" (default) → LocalFileStorageService (disco, volumen storage_data).
# "s3"              → S3FileStorageService (MinIO self-hosted en stack aparte).
# El provider se puede cambiar sin re-deploy de archivos: el campo
# RelativePath de ArchiveFile es compatible entre ambos providers.
# Ver plans/minio-storage.md y plans/ocr-implementation.md para el detalle.
#
# IMPORTANTE: el servicio MinIO corre en su PROPIO stack
# (`idemdd-minio-prod` o el nombre que le hayas puesto en Portainer),
# NO en este stack. Este compose solo lo CONSUME. La conectividad
# entre stacks requiere que ambos estén en la misma red Docker
# (la red `traefik` externa, que ya comparten).
STORAGE_PROVIDER=s3

# Credenciales root de MinIO. Acá se setean para que el backend las
# use como access/secret key del cliente S3. Los MISMOS valores
# tienen que estar configurados en el stack separado de MinIO
# (Portainer → stack `idemdd-minio-prod` → env vars MINIO_ROOT_USER
# y MINIO_ROOT_PASSWORD). Si difieren, el backend rechaza las llamadas
# con InvalidAccessKeyId. En producción, idealmente crear un service
# account dedicado con policy de solo-lo-necesario, pero para la v1
# con root user alcanza.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change_me_min_8_chars

# Backend → MinIO (referencias; si se dejan vacías, el backend
# usa MINIO_ROOT_USER / MINIO_ROOT_PASSWORD como access/secret key).
# En dev local se suelen dejar vacías y funciona; en prod es
# preferible un service account con policy restrictiva.
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_BUCKET=idemdd-archive
STORAGE_S3_ACCESSKEY=
STORAGE_S3_SECRETKEY=
STORAGE_S3_REGION=us-east-1

# --- Backup (scheduled command `backup-database`) ---
# El binario `pg_dump` se instala en la imagen del backend vía el
# paquete `postgresql-client` (ver idemdd-backend/Dockerfile). Si
# modificás la imagen y cambiás su ubicación, actualizá esta env.
# Si la dejas vacía, el código busca `pg_dump` en el PATH.
BACKUP_PG_DUMP_PATH=/usr/bin/pg_dump

# Directorio LOCAL donde se escriben los .sql.gz. Default si está
# vacío: {Storage__RootPath}/backups = /app/Storage/backups (vive en
# el volumen storage_data, persistente entre deploys).
BACKUP_LOCAL_DIR=/app/Storage/backups

# Bucket S3/MinIO donde el command sube el .sql.gz automáticamente
# cuando STORAGE_PROVIDER=s3 y el parámetro upload-to-minio está
# activo. Recomendado: bucket dedicado `idemdd-backups` (ya lo crea
# minio-init al primer arranque; podés configurarle lifecycle
# policy propio para purga separada de los archivos de ArchiveFile).
BACKUP_S3_BUCKET=idemdd-backups

# Prefijo (carpeta) dentro del bucket.
BACKUP_S3_PREFIX=backups/
